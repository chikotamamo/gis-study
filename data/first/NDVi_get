import os
import ee
import geemap

ee.Initialize()
district = ee.Geometry.Rectangle([114.30, 30.50, 114.45, 30.60])  # 研究区范围

start_date = '2026-05-01'
end_date = '2026-09-01'

collection = (
    ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
    .filterDate(start_date, end_date)
    .filterBounds(district)
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 10))
)

get = collection.sort('CLOUDY_PIXEL_PERCENTAGE').first()

scene_id = get.get("system:index").getInfo()
cloud = get.get("CLOUDY_PIXEL_PERCENTAGE").getInfo()

if scene_id is None:
    raise RuntimeError("没有找到符合条件的影像：放宽日期范围或云量阈值")

NDVI = get.normalizedDifference(['B8', 'B4']).rename('NDVI')

scl = get.select('SCL')
clear = (
    scl.neq(3)
    .And(scl.neq(8))
    .And(scl.neq(9))
    .And(scl.neq(10))
    .And(scl.neq(11))
)
ndvi_masked = NDVI.updateMask(clear)

out = os.path.abspath("C:\\Users\\WYF18\\Desktop\\三上\\自学\\first\\NDVI\\NDVI.tif")
os.makedirs(os.path.dirname(out), exist_ok=True)
geemap.ee_export_image(ndvi_masked,
  filename=out, 
  scale=20, 
  region=district, 
  file_per_band=False
)
print(f"NDVI影像已成功导出到: {out}")
